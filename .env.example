DATABASE_URL="postgresql://dd_finance:dd-finance-local@localhost:5432/dd_finance?schema=public"
DIRECT_URL="postgresql://dd_finance:dd-finance-local@localhost:5432/dd_finance?schema=public"
POSTGRES_PASSWORD="dd-finance-local"
NEXT_PUBLIC_LOCAL_AUTH_BYPASS="true"

# Required only when disabling the local auth bypass. Create development credentials in Clerk.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_replace_me"
CLERK_SECRET_KEY="sk_test_replace_me"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/"

# Optional integrations are disabled unless explicitly enabled.
NEXT_PUBLIC_STRIPE_ENABLED="false"
OPENAI_ENABLED="false"

# Only needed when enabling Stripe.
APP_URL="http://localhost:3000"
